# Optional default base URL of the existing ORR Pulse pilot backend.
# This is NOT a secret and is only a convenience default; the URL can always be
# viewed and edited in the mobile app under Settings > Pilot backend connection.
#
# Android emulator talking to a server on your own machine: use http://10.0.2.2:3000
# Physical device on the same Wi-Fi/LAN: use your computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
