# GEMINI_API_KEY: Optional for ORR Pulse (core routing and ETA calculations do not use LLMs).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_MAPS_API_KEY: Server-side Google Maps Platform key for Routes API v2, Places API (New), and Geocoding API.
# Provisioned via AI Studio Google Maps Setup or Google Cloud Console.
GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_API_KEY: Browser-restricted Google Maps Platform key (if provisioned via AI Studio).
VITE_GOOGLE_MAPS_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DAILY_API_QUOTA_LIMIT: Maximum daily Google Maps API requests permitted for the pilot budget safeguard.
DAILY_API_QUOTA_LIMIT="500"
